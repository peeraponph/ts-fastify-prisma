# outbox-service/.env

# db configuration
DATABASE_URL="postgresql://{your_username}:{your_password}@localhost:5432/users?schema=public"

# kafka broker configuration
KAFKA_BROKER="localhost:9092"

# otel configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318/v1/traces
OTEL_SERVICE_NAME=outbox-service

